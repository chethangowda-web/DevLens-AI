# ================================================================
# DevLens AI — Production Environment Variables
# Copy this file to .env on your production server and fill values
# NEVER commit the real .env file to version control
# ================================================================

# ── Server ───────────────────────────────────────────────────────
NODE_ENV=production
PORT=3001

# ── Database (PostgreSQL 16 + pgvector) ──────────────────────────
POSTGRES_USER=devlens_prod
POSTGRES_PASSWORD=CHANGE_ME_strong_postgres_password
POSTGRES_DB=devlens_db
DATABASE_URL=postgresql://devlens_prod:CHANGE_ME_strong_postgres_password@postgres:5432/devlens_db

# ── Redis 7 ──────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_strong_redis_password
REDIS_URL=redis://:CHANGE_ME_strong_redis_password@redis:6379

# ── Auth & Session ───────────────────────────────────────────────
# Generate strong secrets: openssl rand -hex 64
JWT_SECRET=CHANGE_ME_jwt_secret_at_least_64_characters_long_for_hs512_security
COOKIE_SECRET=CHANGE_ME_cookie_secret_at_least_64_characters_long

# ── OpenAI / LLM ─────────────────────────────────────────────────
OPENAI_API_KEY=sk-CHANGE_ME_your_openai_api_key

# ── GitHub OAuth App ─────────────────────────────────────────────
GITHUB_CLIENT_ID=CHANGE_ME_github_oauth_app_client_id
GITHUB_CLIENT_SECRET=CHANGE_ME_github_oauth_app_client_secret
GITHUB_WEBHOOK_SECRET=CHANGE_ME_github_webhook_hmac_secret

# ── Frontend / CORS ──────────────────────────────────────────────
FRONTEND_URL=https://your-production-domain.com

# ── Docker Image Tags ────────────────────────────────────────────
IMAGE_TAG=latest

# ── Logging ──────────────────────────────────────────────────────
LOG_LEVEL=info
